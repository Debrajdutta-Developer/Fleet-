PORT=8787
FLEETOS_INGEST_TOKEN=replace-with-a-long-random-server-secret
FLEETOS_WEB_ORIGIN=http://localhost:3000

# Frontend example:
# VITE_TELEMETRY_API_URL=http://localhost:8787

# Generic provider mappings. Keep the real JSON in your deployment secret/config store.
# This example maps a hypothetical GPS feed with mph -> km/h conversion.
# FLEETOS_PROVIDER_MAPPINGS_JSON=[{"providerId":"vendor-a","kind":"gps","arrayPath":"vehicles","map":{"deviceId":"device.id","vehicleId":"vehicle.number","recordedAt":"timestamp","latitude":"gps.lat","longitude":"gps.lng","speedKph":{"path":"speedMph","multiply":1.609344},"ignitionOn":"ignition","fuelLevelPercent":"fuel.percent"}}]

# A load/weighbridge feed can use the same mechanism, e.g. tonne -> kg:
# FLEETOS_PROVIDER_MAPPINGS_JSON=[{"providerId":"weighbridge-a","kind":"weighbridge","map":{"deviceId":"scaleId","vehicleId":"registration","recordedAt":"time","grossWeightKg":{"path":"grossTonnes","multiply":1000},"tareWeightKg":{"path":"tareTonnes","multiply":1000}}}]

# Add provider credentials only on the server when an authorized provider is connected.
# Never commit real credentials.
# GPS_PROVIDER_BASE_URL=https://provider.example/api/
# GPS_PROVIDER_API_KEY=replace-me
# APISETU_CLIENT_ID=replace-me
# APISETU_CLIENT_SECRET=replace-me
# FASTAG_ISSUER_API_KEY=replace-me
