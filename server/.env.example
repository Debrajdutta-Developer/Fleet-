PORT=8787
FLEETOS_INGEST_TOKEN=replace-with-a-long-random-server-secret
FLEETOS_WEB_ORIGIN=http://localhost:3000

# FleetOS native authentication (recommended when you do not want an external auth provider).
# Requires DATABASE_URL + FLEETOS_JWT_SECRET.
# The bootstrap owner is created only when that email does not already exist.
# After the first successful boot, remove FLEETOS_BOOTSTRAP_OWNER_PASSWORD from hosting secrets.
FLEETOS_JWT_SECRET=replace-with-a-long-random-jwt-secret
FLEETOS_JWT_ISSUER=fleetos
FLEETOS_JWT_AUDIENCE=fleetos-web
# FLEETOS_BOOTSTRAP_OWNER_EMAIL=owner@example.com
# FLEETOS_BOOTSTRAP_OWNER_PASSWORD=replace-with-a-strong-password
# FLEETOS_BOOTSTRAP_COMPANY_ID=company-001
# FLEETOS_BOOTSTRAP_OWNER_NAME=Fleet Owner

# Optional external identity verification: OIDC/JWT provider with remote JWKS.
# FLEETOS_OIDC_JWKS_URL=https://identity.example/.well-known/jwks.json
# FLEETOS_OIDC_ISSUER=https://identity.example/
# FLEETOS_OIDC_AUDIENCE=fleetos-web
# FLEETOS_OIDC_COMPANY_CLAIM=companyId
# FLEETOS_OIDC_ROLE_CLAIM=role

# DEV/SMOKE ONLY. Keep false in production.
FLEETOS_ALLOW_DEV_TOKENS=false
# FLEETOS_TENANT_READ_TOKENS_JSON=[{"token":"local-dev-token","companyId":"comp-101","role":"manager","sub":"user-1"}]

# Preferred production persistence: PostgreSQL.
# DATABASE_URL=postgresql://fleetos:password@db-host:5432/fleetos

# Single-node development fallback when PostgreSQL is not configured.
# FLEETOS_TELEMETRY_HISTORY_FILE=./data/telemetry-history.jsonl

# Durable trip evidence storage option A: Supabase Storage.
# Create a PRIVATE bucket (for example: fleetos-evidence) in Supabase Storage.
# Keep the service role key server-side only. Never expose it in VITE_* variables or the browser.
# FLEETOS_EVIDENCE_SUPABASE_URL=https://your-project-ref.supabase.co
# FLEETOS_EVIDENCE_SUPABASE_BUCKET=fleetos-evidence
# FLEETOS_EVIDENCE_SUPABASE_SERVICE_ROLE_KEY=replace-me

# Durable trip evidence storage option B: AWS S3 or S3-compatible R2/MinIO.
# Keep all credentials in your hosting secret manager.
# FLEETOS_EVIDENCE_S3_BUCKET=fleetos-evidence
# FLEETOS_EVIDENCE_S3_REGION=ap-south-1
# FLEETOS_EVIDENCE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# FLEETOS_EVIDENCE_S3_ACCESS_KEY_ID=replace-me
# FLEETOS_EVIDENCE_S3_SECRET_ACCESS_KEY=replace-me
# FLEETOS_EVIDENCE_S3_FORCE_PATH_STYLE=false

# Local development fallback only:
# FLEETOS_EVIDENCE_DIR=./data/evidence

# Frontend examples. Never put JWT secrets or provider credentials in VITE_* variables.
# VITE_TELEMETRY_API_URL=http://localhost:8787
# VITE_FLEETOS_AUTH_MODE=native

# Generic provider mappings. Every mapping is explicitly tenant-bound.
# Keep real JSON in your deployment secret/config store.
# FLEETOS_PROVIDER_MAPPINGS_JSON=[{"providerId":"vendor-a","companyId":"comp-101","kind":"gps","arrayPath":"vehicles","map":{"deviceId":"device.id","vehicleId":"vehicle.number","recordedAt":"timestamp","latitude":"gps.lat","longitude":"gps.lng","speedKph":{"path":"speedMph","multiply":1.609344},"ignitionOn":"ignition","fuelLevelPercent":"fuel.percent"}}]

# Weighbridge example with tonne -> kg conversion:
# FLEETOS_PROVIDER_MAPPINGS_JSON=[{"providerId":"weighbridge-a","companyId":"comp-101","kind":"weighbridge","map":{"deviceId":"scaleId","vehicleId":"registration","recordedAt":"time","grossWeightKg":{"path":"grossTonnes","multiply":1000},"tareWeightKg":{"path":"tareTonnes","multiply":1000}}}]

# Add provider credentials only on the server when an authorized provider is connected.
# Never commit real credentials.
# GPS_PROVIDER_BASE_URL=https://provider.example/api/
# GPS_PROVIDER_API_KEY=replace-me
# APISETU_CLIENT_ID=replace-me
# APISETU_CLIENT_SECRET=replace-me
# FASTAG_ISSUER_API_KEY=replace-me
