PORT=8787
FLEETOS_INGEST_TOKEN=replace-with-a-long-random-server-secret
FLEETOS_WEB_ORIGIN=http://localhost:3000

# Frontend API base only. Do not place telemetry read secrets in VITE_* variables.
# VITE_TELEMETRY_API_URL=http://localhost:8787

# Temporary server-side tenant read-token map for development/smoke testing.
# Production should replace this with your real authenticated session/JWT verifier.
# FLEETOS_TENANT_READ_TOKENS_JSON=[{"token":"replace-with-a-long-random-token","companyId":"comp-india-001","role":"manager"}]

# Generic provider mappings. Each provider connection is explicitly bound to one tenant company.
# Keep the real JSON in your deployment secret/config store.
# FLEETOS_PROVIDER_MAPPINGS_JSON=[{"providerId":"vendor-a","companyId":"comp-india-001","kind":"gps","arrayPath":"vehicles","map":{"deviceId":"device.id","vehicleId":"vehicle.number","recordedAt":"timestamp","latitude":"gps.lat","longitude":"gps.lng","speedKph":{"path":"speedMph","multiply":1.609344},"ignitionOn":"ignition","fuelLevelPercent":"fuel.percent"}}]

# A load/weighbridge feed can use the same mechanism, e.g. tonne -> kg:
# FLEETOS_PROVIDER_MAPPINGS_JSON=[{"providerId":"weighbridge-a","companyId":"comp-india-001","kind":"weighbridge","map":{"deviceId":"scaleId","vehicleId":"registration","recordedAt":"time","grossWeightKg":{"path":"grossTonnes","multiply":1000},"tareWeightKg":{"path":"tareTonnes","multiply":1000}}}]

# Add provider credentials only on the server when an authorized provider is connected.
# Never commit real credentials.
# GPS_PROVIDER_BASE_URL=https://provider.example/api/
# GPS_PROVIDER_API_KEY=replace-me
# APISETU_CLIENT_ID=replace-me
# APISETU_CLIENT_SECRET=replace-me
# FASTAG_ISSUER_API_KEY=replace-me
